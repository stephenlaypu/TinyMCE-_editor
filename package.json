{
  "name": "tinymce-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:cms-css": "node scripts/generate-cms-content-css.mjs",
    "predev": "pnpm generate:cms-css",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write src/editor tests/editor src/App.vue package.json",
    "format:check": "prettier --check src/editor tests/editor src/App.vue package.json",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "prebuild": "pnpm generate:cms-css",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@tinymce/tinymce-vue": "^6.3.0",
    "codemirror": "^6.0.2",
    "prettier": "^3.9.7",
    "tinymce": "8.9.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
